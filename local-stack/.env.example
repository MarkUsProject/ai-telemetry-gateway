# Copy to `.env` (same directory) and fill in values before running
# `docker compose up`. `.env` is gitignored — never commit secrets.
#
# Every value below is a LOCAL ASSUMPTION (see docker-compose.yml inline
# comments). PROD: same variable names, sourced from sysadmin's secret store.

# ---------- PostgreSQL ----------
# Admin role on the Postgres instance. Used for schema migrations and to
# bootstrap the application role (see init-db.sql).
POSTGRES_USER=aitg_admin

# Generate locally with: openssl rand -hex 32
# Local-only value; rotate before any production-adjacent use.
POSTGRES_PASSWORD=

# Database name. Both LiteLLM's internal tables and (in Phase 3) our 5
# tables live here.
POSTGRES_DB=aitg

# ---------- LiteLLM ----------
# Master key for the proxy. Must start with `sk-`. Callers authenticate with
# this directly, or with a virtual key minted from it via the /ui panel.
# Generate locally with: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# Encrypts upstream provider keys (OPENAI_API_KEY, etc.) at rest in the
# LiteLLM-owned tables. Rotating this re-encrypts those columns.
# Generate locally with: openssl rand -hex 32
LITELLM_SALT_KEY=

# ---------- Upstream providers ----------
# Optional locally. Without this set, the stack still starts and the /health
# endpoint responds, but chat completions return a provider error.
OPENAI_API_KEY=

# ---------- Our encryption ----------
# Encrypts upstream provider keys at rest in the aitg.api_keys table.
# Separate from LITELLM_SALT_KEY so we can rotate independently of LiteLLM.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AITG_ENCRYPTION_KEY=
